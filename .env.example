# Copy to .env (`cp .env.example .env`). The defaults below are also baked into
# docker-compose.yml, so .env is optional for local dev.
# TOLLGATE_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# OLLAMA_PORT=11434
# Ollama endpoint as seen from the gateway container. Default: native Ollama on the host.
TOLLGATE_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Fallback: Ollama in Docker — also start with `docker compose --profile ollama-docker up -d`
# TOLLGATE_OLLAMA_BASE_URL=http://ollama:11434
# TOLLGATE_JWT_SECRET=change-me
# TOLLGATE_BOOTSTRAP_ADMIN_EMAIL=admin@tollgate.local
# TOLLGATE_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password
# Optional hosted providers (Phase 3)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
