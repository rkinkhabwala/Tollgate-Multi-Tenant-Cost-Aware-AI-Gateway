# Copy to .env to override defaults. Nothing here is required for local dev.
# TOLLGATE_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# OLLAMA_PORT=11434
# Faster on macOS: use the host's native Ollama instead of the container
# TOLLGATE_OLLAMA_BASE_URL=http://host.docker.internal:11434
# TOLLGATE_JWT_SECRET=change-me
# TOLLGATE_BOOTSTRAP_ADMIN_EMAIL=admin@tollgate.local
# TOLLGATE_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password
# Optional hosted providers (Phase 3)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
